# Copia este archivo como .env y completa tus datos (el .env no se comparte).
KOBO_URL=https://eu.kobotoolbox.org
KOBO_USER=
KOBO_PASS=

# Carpeta donde se crean las carpetas por usuario con los PDF (ID_NOMBRE)
OUTPUT_DIR=salida

# chrome = usa el Google Chrome instalado; vacio = Chromium de Playwright
BROWSER_CHANNEL=chrome

# Excel con los usuarios a revisar (columna D = REALIZADO)
EXCEL_PATH=USUARIOS.xlsx
# Columnas de Kobo (texto que contiene el encabezado; "a+b" = debe tener ambos)
KOBO_COLUMNA_USUARIO=persona atendida+usuario
KOBO_COLUMNA_CASA=persona atendida+direccion
KOBO_COLUMNA_NOMBRE=persona atendida+nombre

# Pausa en ms entre acciones del navegador (0 = maxima velocidad)
SLOW_MO=0
# Velocidad: pausas al azar (1 = completas, 0.3 = rapido, 0 = sin pausas) y TECLEAR=1 para escribir tecla por tecla
ESCALA_PAUSAS=0.3
TECLEAR=0
# Lado mayor de las fotos en el PDF (px)
FOTOS_PDF_MAX=1600

# Carpeta base de los PDF por usuario y encabezado/pie de pagina en el PDF (1 = si, 0 = no)
CONTINGENCIAL_DIR=CONTINGENCIAL
PDF_ENCABEZADOS=1

# Hoja de Google a actualizar (iniciar sesion una vez con herramientas/sesion_google.py)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1sKzEkMpefgbGclUG54sgASOmp6Dr7EJR/edit#gid=1042612756

# 1 = preguntar en una ventana cuando nombre o casa no coinciden entre Kobo, Excel y hoja
PREGUNTAR_DUDAS=1
